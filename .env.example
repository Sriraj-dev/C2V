# Copy to .env.dev (local / default) and .env.prod (production values). Never commit either.
# Scripts load .env.${ENV:-dev}, e.g. `ENV=prod pnpm orders ...` reads .env.prod.
# On Cloud Run these come from Secret Manager / --set-env-vars, not from files.

# --- Server ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Public https origin of this server; Cashfree webhook callbacks are built from it.
PUBLIC_BASE_URL=

# --- Database (Supabase Postgres, connect as the postgres role) ---
DATABASE_URL=

# --- Meta / WhatsApp Cloud API (app "C2V") ---
META_APP_SECRET=
META_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# --- Cashfree: sandbox or production ---
CASHFREE_ENV=sandbox

# --- Shared secret for POST /jobs/* (Cloud Scheduler sends it as x-jobs-secret); unset = jobs refuse ---
JOBS_SECRET=

# --- Tenant: nutrifarm ---
# WhatsApp system-user token and Cashfree app credentials for this tenant.
NUTRIFARM_WA_TOKEN=
NUTRIFARM_CF_APP_ID=
NUTRIFARM_CF_SECRET=
# Optional: published Subscribe Flow id (empty = Subscribe replies "coming soon"); DRAFT=1 only for testing a draft.
NUTRIFARM_SUBSCRIBE_FLOW_ID=
NUTRIFARM_SUBSCRIBE_FLOW_DRAFT=
# Optional overrides of the IDs in src/tenants/nutrifarm/config.ts (e.g. point at Meta's test number in dev).
NUTRIFARM_WA_PHONE_NUMBER_ID=
NUTRIFARM_WABA_ID=
