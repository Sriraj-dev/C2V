{
  "name": "c2v-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "flows:publish": "tsx --env-file-if-exists=.env scripts/publish-flows.ts",
    "samples:send": "tsx --env-file-if-exists=.env scripts/send-samples.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
