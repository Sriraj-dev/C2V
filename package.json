{
  "name": "c2v-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.${ENV:-dev} src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "start": "node --env-file-if-exists=.env.${ENV:-dev} dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/seed.ts",
    "flows:publish": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/publish-flows.ts",
    "cashfree:check": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/cashfree-link-check.ts",
    "cashfree:subs-check": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/cashfree-subs-check.ts",
    "checkout:test": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/checkout-check.ts",
    "db:schedule-cleanup": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/schedule-cleanup.ts",
    "samples:send": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/send-samples.ts",
    "orders": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/orders.ts",
    "vendors": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/vendors.ts",
    "templates:create": "tsx --env-file-if-exists=.env.${ENV:-dev} scripts/templates.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
